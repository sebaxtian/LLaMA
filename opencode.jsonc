{
  "$schema": "https://opencode.ai/config.json",

  // Use the primary implementation agent for project changes.
  "default_agent": "plan",

  // MEMORY.md contains the project's operational context.
  // AGENTS.md is discovered automatically by OpenCode.
  "instructions": ["MEMORY.md"],

  // Local llama.cpp server exposed through its OpenAI-compatible API.
  "providers": {
    "LLaMA": {
      "name": "LLaMA.cpp Local",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:9931/v1",
        "encoding": "none",
      },
      "models": {
        "Gemma-4-26B-A4B": {
          "name": "Gemma-4-26B-A4B",
          "modelID": "Gemma-4-26B-A4B",
        },
      },
    },
  },

  // Ignore local artifacts and the external llama.cpp checkout in the watcher.
  "watcher": {
    "ignore": [
      "bin/**",
      "models/**",
      "llama.cpp/**",
      "logs/**",
      "results/**",
      "tmp/**",
    ],
  },

  // The local llama.cpp checkout is reference-only and must not be edited.
  "permissions": [
    {
      "action": "edit",
      "resource": "llama.cpp/*",
      "effect": "deny",
    },
    {
      "action": "edit",
      "resource": "bin/*",
      "effect": "deny",
    },
    {
      "action": "edit",
      "resource": "models/*",
      "effect": "deny",
    },
    {
      "action": "read",
      "resource": ".env",
      "effect": "deny",
    },
    {
      "action": "edit",
      "resource": ".env",
      "effect": "deny",
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "ask",
    },
    {
      "action": "shell",
      "resource": "git tag *",
      "effect": "ask",
    },
  ],

  // Official remote GitHub MCP server. The token is read from the environment.
  "mcp": {
    "servers": {
      "github-mcp": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}",
          "X-MCP-Toolsets": "context,repos,issues,pull_requests",
        },
      },
    },
  },
}
